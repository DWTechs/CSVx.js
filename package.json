{
  "name": "@dwtechs/csvx",
  "version": "0.4.0",
  "description": "CSV Export library written in TypeScript.",
  "keywords": [
    "csv",
    "csv export",
    "csv converter"
  ],
  "homepage": "https://github.com/DWTechs/CSVx.js",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "sideEffects": false,
  "main": "dist/csvx.js",
  "types": "dist/csvx.d.ts",
  "exports": {
    ".": {
      "types": "./dist/csvx.d.ts",
      "import": "./dist/csvx.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DWTechs/CSVx.js.git"
  },
  "bugs": {
    "url": "https://github.com/DWTechs/CSVx.js/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Ludovic Cluber",
    "url": "http://www.lcluber.com"
  },
  "contributors": [],
  "scripts": {
    "prebuild": "npm install",
    "build": "node ./scripts/clear.js && tsc && npm run rollup && node ./scripts/copy.js && npm run test",
    "rollup": "rollup --config rollup.config.mjs",
    "test": "jest --coverage"
  },
  "files": [
    "dist/"
  ],
  "dependencies": {
    "@dwtechs/checkard": "3.7.0"
  },
  "devDependencies": {
    "@babel/core": "7.23.2",
    "@babel/preset-env": "7.23.2",
    "babel-jest": "29.7.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "rollup": "4.24.0",
    "rollup-plugin-dts": "6.5.1",
    "typescript": "5.6.3"
  }
}
